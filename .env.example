# Copy to .env and fill in. Never commit .env.
PORT=3000
# Where customers open the site; ЮKassa sends them back to $PUBLIC_URL/order?id=…
PUBLIC_URL=http://localhost:5173

# ЮKassa → Настройки → Магазин (shopId) and Интеграция → Ключи API (secret key).
# A test shop's key starts with test_; a live one with live_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 = send a 54-ФЗ receipt with every payment (needs «Чеки от ЮKassa» or a connected online cash register)
YOOKASSA_RECEIPTS=0
# VAT code for receipt lines: 1 = без НДС, 2 = 0%, 4 = 20%, 7 = 5%, 8 = 7% (see ЮKassa docs)
YOOKASSA_VAT_CODE=1
